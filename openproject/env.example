##
# Demo / quick start
# ------------------
#   cp .env.example .env
#   # Then replace the IP placeholder in BOTH assignments below
#   # (see README: sed on .env — do not leave the placeholder string).
#
# For production: set OPENPROJECT_HTTPS=true, use an FQDN, and regenerate all secrets.
# Docs: https://www.openproject.org/docs/installation-and-operations/configuration/environment/
#

TAG=17-slim

# --- Lab / demo (HTTP + IP) — change the two assignments only ---
OPENPROJECT_HTTPS=false
OPENPROJECT_HOST__NAME=YOUR_SERVER_IP
PORT=0.0.0.0:8080
COLLABORATIVE_SERVER_URL=ws://YOUR_SERVER_IP:8080/hocuspocus

# --- Production example (FQDN + reverse proxy) — uncomment & comment lab block above ---
# OPENPROJECT_HTTPS=true
# OPENPROJECT_HOST__NAME=openproject.example.com
# PORT=0.0.0.0:8080
# COLLABORATIVE_SERVER_URL=wss://openproject.example.com/hocuspocus

OPENPROJECT_RAILS__RELATIVE__URL__ROOT=
IMAP_ENABLED=false

# Demo secrets (OK for lab). Production: regenerate!
#   head /dev/urandom | tr -dc A-Za-z0-9 | head -c 64 ; echo
SECRET_KEY_BASE=DemoOnlyChangeInProduction_OpenProjectSecretKeyBase_64ch
COLLABORATIVE_SERVER_SECRET=DemoOnlyChangeInProduction_Hocuspocus

# Must match: same password in DATABASE_URL and POSTGRES_PASSWORD
POSTGRES_PASSWORD=DemoOnlyChangeInProduction_DbPass
DATABASE_URL=postgres://postgres:DemoOnlyChangeInProduction_DbPass@db/openproject?pool=20&encoding=unicode&reconnect=true

RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16

# Named Docker volumes (do not use host paths like /var/lib/postgresql/data)
PGDATA=pgdata
OPDATA=opdata

POSTGRES_VERSION=17
